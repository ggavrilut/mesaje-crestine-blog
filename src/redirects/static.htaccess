# Old WordPress URLs that are not posts (docs/seo.md, the move). Hand-maintained; copied into
# .htaccess at build after the generated per-post rules. mod_alias applies the first match,
# so exact rules stay above patterns. Every target is absolute, so no second hop to https.

# Pages and archives
RedirectMatch 301 ^/acasa-2/?$ https://mesaje-crestine.ro/
RedirectMatch 301 ^/page/[0-9]+/?$ https://mesaje-crestine.ro/blog/
RedirectMatch 301 ^/category/ https://mesaje-crestine.ro/blog/
RedirectMatch 301 ^/tag/ https://mesaje-crestine.ro/blog/
RedirectMatch 301 ^/author/ https://mesaje-crestine.ro/blog/
RedirectMatch 301 ^/authors/([a-z0-9-]+)/page/[0-9]+/?$ https://mesaje-crestine.ro/authors/$1/
RedirectMatch 301 ^/[0-9]{4}/(?:[0-9]{2}/(?:[0-9]{2}/)?)?(?:page/[0-9]+/?)?$ https://mesaje-crestine.ro/blog/

# Feeds and sitemaps
RedirectMatch 301 ^/feed/?$ https://mesaje-crestine.ro/rss.xml
RedirectMatch 301 ^/.+/feed/?$ https://mesaje-crestine.ro/rss.xml
RedirectMatch 301 ^/sitemap\.rss$ https://mesaje-crestine.ro/rss.xml
RedirectMatch 301 ^/sitemap\.xml$ https://mesaje-crestine.ro/sitemap-index.xml
RedirectMatch 301 ^/[a-z_-]+-sitemap\.xml$ https://mesaje-crestine.ro/sitemap-index.xml

# Placeholders with no equivalent: gone (docs/seo.md, content quality signals)
RedirectMatch 410 ^/sample-page/?$
RedirectMatch 410 ^/template/
RedirectMatch 410 ^/despre-noi/?$

# Quotes and daily verses: one sentence each; to the post on the same subject, else gone
# (specs/wordpress-import.md, remaining old URLs, owner 2026-10-23)
RedirectMatch 301 ^/quote/?$ https://mesaje-crestine.ro/blog/
RedirectMatch 301 ^/quote/105/?$ https://mesaje-crestine.ro/domn-peste-toate-sau-deloc/
RedirectMatch 301 ^/quote/107/?$ https://mesaje-crestine.ro/focalizat-o-poveste-si-o-cantare/
RedirectMatch 301 ^/quote/cristos-este-sau-domn-peste-toate-sau-nu-este-domn-deloc-hudson-taylor/?$ https://mesaje-crestine.ro/domn-peste-toate-sau-deloc/
RedirectMatch 301 ^/dailyverse/?$ https://mesaje-crestine.ro/blog/
RedirectMatch 301 ^/dailyverse/2021-10-18-ioan-1415/?$ https://mesaje-crestine.ro/ma-iubesti/
RedirectMatch 301 ^/dailyverse/2021-10-20-ioan-1623/?$ https://mesaje-crestine.ro/eu-am-biruit-lumea-ioan-1633/
RedirectMatch 410 ^/dailyverse/2021-11-03-evrei-1228/?$
RedirectMatch 410 ^/dailyverse/2021-11-09-psalmul-1492/?$
RedirectMatch 301 ^/dailyverse/2022-03-09-luca-2136/?$ https://mesaje-crestine.ro/rugaciunea-pentru-revenirea-domnului/

# Everything else WordPress kept under /wp-content/ (theme files, unused uploads): gone. Last,
# so the importer's rules for covers, portraits and the PDF match first.
RedirectMatch 410 ^/wp-content/
