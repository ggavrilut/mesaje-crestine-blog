---
// Page numbers: 1 2 3 … 8 →, the current page filled.
interface Props {
  current: number;
  pages: number;
  pathOf: (n: number) => string;
}

const { current, pages, pathOf } = Astro.props;
// First, last, and the current page with two neighbours each side, as WordPress did; gaps
// become "…".
const shown = [...new Set([1, current - 2, current - 1, current, current + 1, current + 2, pages])].filter((n) => n >= 1 && n <= pages).sort((a, b) => a - b);
const items: (number | '…')[] = shown.flatMap((n, i) => (i > 0 && n - shown[i - 1] > 1 ? ['…' as const, n] : [n]));
---
{pages > 1 && (
  <nav class="pager" aria-label="Paginare">
    {current > 1 && <a class="arrow" href={pathOf(current - 1)} rel="prev" aria-label="Pagina anterioară">←</a>}
    {items.map((n) =>
      n === '…' ? <span class="gap" aria-hidden="true">…</span>
      : n === current ? <span class="current" aria-current="page">{n}</span>
      : <a href={pathOf(n)}>{n}</a>,
    )}
    {current < pages && <a class="arrow" href={pathOf(current + 1)} rel="next" aria-label="Pagina următoare">→</a>}
  </nav>
)}
