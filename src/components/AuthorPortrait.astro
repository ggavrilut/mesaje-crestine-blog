---
// An author's round portrait, or the design's striped circle when there is none. The name is
// always printed next to it, so the image is decorative (empty alt).
import { Image } from 'astro:assets';
import type { Author } from '../lib/site.ts';

interface Props {
  author: Author;
  size: number;
}

const { author, size } = Astro.props;
const { image, imagePosition } = author.data;
---
{image ? (
  <Image
    class="avatar"
    src={image}
    alt=""
    width={size}
    height={size}
    densities={[1, 2]}
    fit="cover"
    position={imagePosition}
    loading="lazy"
    style={`width:${size}px;height:${size}px`}
  />
) : <span class="avatar" aria-hidden="true" style={`width:${size}px;height:${size}px`}></span>}
