---
// The two-column article list of the design handoff.
import PostCard from './PostCard.astro';
import { getAuthors, type Post } from '../lib/site.ts';

interface Props {
  posts: Post[];
  headingLevel?: 2 | 3;
}

const { posts, headingLevel } = Astro.props;
const authors = await getAuthors();
---
<div class="post-grid">
  {posts.map((post) => <PostCard post={post} authors={authors} headingLevel={headingLevel} />)}
</div>
