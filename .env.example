# Copy to .env (git-ignored) and fill in. Never commit .env.
# FTPS deploy account: a dedicated cPanel FTP account restricted to public_html,
# not the main cPanel login (docs/dev-environment.md).
FTP_HOST=titan.solutiiweb.com
FTP_USER=
FTP_PASSWORD=
FTP_REMOTE_DIR=/

# Contact form (server-side secrets; docs/architecture.md, contact form)
TURNSTILE_SECRET_KEY=
SMTP_PASSWORD=
